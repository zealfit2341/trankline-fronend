{
  "name": "shuttle-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node init && vite",
    "build": "node init && tsc -b && vite build",
    "preview": "vite preview",
    "db:check": "node server/check-db.cjs",
    "db:migrate": "node server/migrate.cjs",
    "db:migrate:main-gate": "node server/migrate-main-gate.cjs",
    "db:seed": "node server/migrate.cjs",
    "server": "node server/index.cjs",
    "server:dev": "node --watch server/index.cjs",
    "dev:all": "node init && concurrently -k \"npm:server:dev\" \"npm:dev\""
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.12",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.11.5",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
